{
  "name": "wealth-tracker",
  "version": "1.0.1",
  "private": true,
  "packageManager": "yarn@4.17.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0 && yarn format:check",
    "lint:fix": "eslint . --fix && yarn format",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "db:migrate-dry": "node --experimental-strip-types scripts/db-migrate-dry.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/sql.js": "^1.4.11",
    "eslint": "^10.15.0",
    "jsdom": "^31.0.0",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "echarts": "6.1.0",
    "idb-keyval": "^6.3.0",
    "pdfjs-dist": "6.5.438",
    "sql.js": "1.15.2"
  }
}
